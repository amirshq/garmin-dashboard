# Personal API key from https://connect.garmin.com (Personal API Key page). Never commit .env.
GARMIN_API_KEY=
# Optional overrides
# GARMIN_BASE_URL=https://personal.connectapi.garmin.com
# GARMIN_DB_PATH=data/garmin.db

# Password for the encrypted GitHub Pages snapshot (make publish). Use 5+ random words, 16+ chars.
SNAPSHOT_PASSWORD=
